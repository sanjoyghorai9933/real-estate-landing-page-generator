# Raise PHP upload limits so bulk-selecting many slider / floor plan /
# gallery / amenity images at once doesn't silently truncate $_FILES.
# Only takes effect on mod_php-based hosting; harmless no-op otherwise.
# (For PHP-FPM/CGI hosting, see .user.ini in this same folder instead.)
<IfModule mod_php.c>
    php_value upload_max_filesize 25M
    php_value post_max_size 100M
    php_value max_file_uploads 60
    php_value max_execution_time 120
    php_value max_input_time 120
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 25M
    php_value post_max_size 100M
    php_value max_file_uploads 60
    php_value max_execution_time 120
    php_value max_input_time 120
</IfModule>
